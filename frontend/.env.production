# 프로덕션 빌드 전용 (vite build). git 추적됨.
# VITE_* 중 비밀은 없음: API 키는 브라우저 번들이 아니라 Functions(Secret Manager)에만 존재.
# VITE_FIREBASE_API_KEY 는 비밀이 아니라 식별자라 인라인 무방.

# 배포된 Firebase Functions base URL (us-central1).
VITE_API_BASE_URL=https://us-central1-socratic-learn-web.cloudfunctions.net

# Firebase 웹 클라이언트 config (GitHub 로그인용) - .env.local 과 동일 값.
VITE_FIREBASE_API_KEY=AIzaSyDEyglKvt52U67e1ie05GfE5AfM044qWbk
VITE_FIREBASE_AUTH_DOMAIN=socratic-learn-web.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=socratic-learn-web
VITE_FIREBASE_STORAGE_BUCKET=socratic-learn-web.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=383127936934
VITE_FIREBASE_APP_ID=1:383127936934:web:3da5b75733a97ebc36b967
