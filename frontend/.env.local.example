# 로컬 개발 전용 - 이 파일을 복사해 `.env.local` 로 만든 뒤 값을 채우세요.
# .env.local 은 gitignore 대상입니다. 절대 커밋하지 마세요.

# Firebase Functions(또는 과도기 Ktor) 백엔드 base URL.
# - Firebase Emulator: http://127.0.0.1:5001/<project-id>/us-central1
#   (예: http://127.0.0.1:5001/socratic-learn-dev/us-central1)
# - 배포된 Functions: https://us-central1-<project-id>.cloudfunctions.net
VITE_API_BASE_URL=http://127.0.0.1:5001/socratic-learn-dev/us-central1

# (이전 중) 아직 Firebase Functions 로 옮기지 않은 함수는 여전히 브라우저에서
# Anthropic 을 직접 호출하므로 이 키가 필요합니다. 7개 함수 이전이 끝나면 제거됩니다.
# 이 키는 Vite 빌드 시점에 번들에 인라인되므로 배포 빌드에는 사용하지 마세요.
VITE_ANTHROPIC_API_KEY=replace-me
