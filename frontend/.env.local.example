# 로컬 개발 전용 - 이 파일을 복사해 `.env.local` 로 만든 뒤 값을 채우세요.
# .env.local 은 gitignore 대상입니다. 절대 커밋하지 마세요.

# Firebase Functions(또는 과도기 Ktor) 백엔드 base URL.
# - Firebase Emulator: http://127.0.0.1:5001/<project-id>/us-central1
#   (예: http://127.0.0.1:5001/socratic-learn-web/us-central1)
# - 배포된 Functions: https://us-central1-<project-id>.cloudfunctions.net
VITE_API_BASE_URL=http://127.0.0.1:5001/socratic-learn-web/us-central1

# Firebase 웹 클라이언트 config (GitHub 로그인용).
# Firebase Console -> 프로젝트 설정 -> 일반 -> 내 앱(웹) 의 firebaseConfig 값을 넣는다.
# apiKey 는 비밀이 아니라 식별자이므로 번들 인라인되어도 무방하다.
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=socratic-learn-web.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=socratic-learn-web
VITE_FIREBASE_STORAGE_BUCKET=replace-me
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-me
VITE_FIREBASE_APP_ID=replace-me
